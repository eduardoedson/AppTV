# Copie este arquivo para .env. Não coloque aspas e não versione o .env real.

# Catálogo aberto por padrão. Aceita HTTPS direto ou link de arquivo do Google Drive.
DEFAULT_CATALOG_URL=https://drive.google.com/file/d/ID_DO_CATALOGO/view

# Opcional: chave da Google Drive API para arquivos públicos.
# Deixe vazio quando usar as credenciais OAuth abaixo para arquivos privados.
GOOGLE_DRIVE_API_KEY=

# Acesso somente leitura a arquivos privados do Google Drive.
# Use um cliente OAuth do tipo "App para computador" e um refresh token da mesma conta.
GOOGLE_OAUTH_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=SEU_CLIENT_SECRET
GOOGLE_OAUTH_REFRESH_TOKEN=SEU_REFRESH_TOKEN

# Manifesto de atualização gerado por `npm run apk:publicar`.
# Pode começar vazio; o publicador preenche esta variável automaticamente.
UPDATE_MANIFEST_URL=https://drive.google.com/file/d/ID_DO_MANIFESTO/view
