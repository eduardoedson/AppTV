# Catalog loaded when no other URL is configured in the app (AppTV.catalago.json on Google Drive)
DEFAULT_CATALOG_URL=

# Google Drive API key (Google Cloud Console > APIs e servicos > Credenciais > Chave de API)
GOOGLE_DRIVE_API_KEY=

# Private Google Drive access (OAuth client of type "Desktop app" in Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Filled automatically by: npm run google:login
GOOGLE_OAUTH_REFRESH_TOKEN=

# App updates: AppTV.update.json on Google Drive (filled automatically by scripts/publicar-apk)
UPDATE_MANIFEST_URL=
